# Privy app from https://dashboard.privy.io — required for Polymarket-style login
# Enable Email, Google, and Wallet. Allowlist localhost:3000 and your public origin.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public builder attribution (grants / weekly volume). Safe to expose.
NEXT_PUBLIC_POLYMARKET_BUILDER_CODE=0xfcf61013fa455e1afe636d9bd6dc452db0a095e407fe62504e85dffba73082a8
POLYMARKET_BUILDER_ADDRESS=0xbfb156599617d87c2cff7b47fb55da3213c24abd

# From polymarket.com → Settings → Builders → Create New (server only, never NEXT_PUBLIC_)
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# Server-only Sentry. Never NEXT_PUBLIC_. Production ingest DSN from org arshia-lr / project leadgap.
SENTRY_DSN=

# Netlify production: shared Worker service (server only).
# Same random secret must be configured with `wrangler secret put` in the Worker.
DATA_SERVICE_URL=
DATA_SERVICE_SECRET=
ENABLE_DURABLE_DATA=false
INGEST_HEALTH_SECRET=
# Legacy/local ingestion endpoint only; production requires a bearer secret.
CRON_SECRET=

# Enable independently after the data service and owner checks pass.
ENABLE_RESEARCH=false
NEXT_PUBLIC_ENABLE_RESEARCH=false
NEXT_PUBLIC_ENABLE_HISTORY=false
NEXT_PUBLIC_ENABLE_STREAMING=false
NEXT_PUBLIC_ENABLE_TELEMETRY=false

# Privy dashboard: allowlist the exact Netlify site URL and custom domain.
# Set account, builder and service secrets in production context only.
# Preview builds default to research/streaming/telemetry off in netlify.toml.
# Never prefix server secrets with NEXT_PUBLIC_.
