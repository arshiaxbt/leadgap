{
  "name": "poly-event-terminal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 3000 --experimental-https",
    "dev:http": "next dev --port 3000",
    "dev:all": "next dev --port 3000 --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "worker:check": "wrangler deploy --dry-run --config workers/data/wrangler.jsonc",
    "worker:dev": "wrangler dev --config workers/data/wrangler.jsonc",
    "worker:migrate:local": "wrangler d1 migrations apply leadgap-data --local --config workers/data/wrangler.jsonc",
    "research:export": "tsx scripts/research-export.ts",
    "research:calibrate": "tsx scripts/calibrate.ts",
    "research:soak": "tsx scripts/soak.ts",
    "test:worker": "tsx scripts/check-worker.ts"
  },
  "dependencies": {
    "@polymarket/client": "^0.6.0",
    "@privy-io/node": "^0.34.0",
    "@privy-io/react-auth": "^3.43.0",
    "@privy-io/wagmi": "^4.0.17",
    "@sentry/nextjs": "^10.70.0",
    "@solana-program/memo": "^0.12.0",
    "@solana-program/system": "^0.13.0",
    "@solana-program/token": "^0.15.0",
    "@solana/kit": "^7.0.0",
    "@stripe/stripe-js": "^1.54.2",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.7.2",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.5",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.2",
    "rss-parser": "^3.13.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.56.0",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@netlify/edge-functions": "^4.0.0",
    "@netlify/plugin-nextjs": "^5.16.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "miniflare": "^5.20260917.0-alpha",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wrangler": "^4.134.0"
  },
  "overrides": {
    "ws": "^8.21.0"
  }
}
