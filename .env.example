# Privy app from https://dashboard.privy.io — required for Polymarket-style login
# Enable Email, Google, and Wallet. Allowlist localhost:3000 and your public origin.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Vercel cron sends Authorization: Bearer ${CRON_SECRET} to /api/ingest
CRON_SECRET=

# Public builder attribution (grants / weekly volume). Safe to expose.
NEXT_PUBLIC_POLYMARKET_BUILDER_CODE=0xfcf61013fa455e1afe636d9bd6dc452db0a095e407fe62504e85dffba73082a8
POLYMARKET_BUILDER_ADDRESS=0xbfb156599617d87c2cff7b47fb55da3213c24abd

# From polymarket.com → Settings → Builders → Create New (server only, never NEXT_PUBLIC_)
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# Server-only Sentry. Never NEXT_PUBLIC_. Production ingest DSN from org arshia-lr / project leadgap.
SENTRY_DSN=

# Scope POLYMARKET_BUILDER_* and PRIVY_APP_SECRET to Production. Protect Preview deployments.
# In-memory API rate limits do not survive serverless isolates — add Vercel WAF rules for
# /api/builder/sign, /api/ingest, /api/book, and /api/klines.
